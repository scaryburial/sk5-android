<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nav</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/card</item>
    </style>
</resources>
